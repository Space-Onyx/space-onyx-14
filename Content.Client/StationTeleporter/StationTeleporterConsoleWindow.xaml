<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:ui="clr-namespace:Content.Client.StationTeleporter"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'teleporter-console-user-interface-title'}"
               Resizable="False"
               SetSize="1010 700"
               MinSize="1010 700">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True">
            <!-- <Onyx-StationTeleporterUI-edited> -->
            <PanelContainer StyleClasses="PanelInsetDark" HorizontalExpand="True" VerticalExpand="True" Margin="8">
                <ui:StationTeleporterNavMapControl Name="NavMap" HorizontalExpand="True" VerticalExpand="True" Margin="2" />
            </PanelContainer>
            <BoxContainer Orientation="Vertical" Margin="0 10 0 10">
                <controls:StripeBack Margin="0 0 0 8">
                    <PanelContainer StyleClasses="PanelDark">
                        <BoxContainer Orientation="Vertical" Margin="12 8">
                            <Label Name="StationName" Text="{Loc 'teleporter-console-user-interface-unknown-station'}"
                                   StyleClasses="LabelBig" />
                            <Label Text="{Loc 'teleporter-console-user-interface-select-hint'}"
                                   StyleClasses="LabelSubText" Margin="0 2 0 0" />
                        </BoxContainer>
                    </PanelContainer>
                </controls:StripeBack>

                <ScrollContainer Name="TeleportersScroller"
                                 VerticalExpand="True"
                                 SetWidth="320"
                                 Margin="0 0 0 8">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 0 8 0">
                        <Label Text="{Loc 'teleporter-console-user-interface-list-title'}"
                               StyleClasses="LabelHeading" Margin="4 0 4 6" />
                        <BoxContainer Name="TeleportersTable"
                                       Orientation="Vertical"
                                       HorizontalExpand="True">
                        <!-- Table rows are filled by code -->
                        </BoxContainer>
                        <Label Name="NoTeleportersLabel"
                               Text="{Loc 'teleporter-console-user-interface-no-teleporters'}"
                               StyleClasses="LabelHeading"
                               HorizontalAlignment="Center"
                               Visible="false" />
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
            <!-- </Onyx-StationTeleporterUI-edited> -->
        </BoxContainer>

        <!-- Footer -->
        <BoxContainer Orientation="Vertical">
            <PanelContainer StyleClasses="LowDivider" />
            <BoxContainer Orientation="Horizontal" Margin="10 4 5 0" VerticalAlignment="Bottom"> <!-- <Onyx-StationTeleporterUI-edited> -->
                <Label Text="{Loc 'teleporter-console-user-interface-flavor-left'}" StyleClasses="WindowFooterText" />
                <Label Text="{Loc 'teleporter-console-user-interface-flavor-right'}" StyleClasses="WindowFooterText"
                        HorizontalAlignment="Right" HorizontalExpand="True"  Margin="0 0 5 0" />
                <TextureRect StyleClasses="NTLogoDark" Stretch="KeepAspectCentered"
                        VerticalAlignment="Center" HorizontalAlignment="Right" SetSize="19 19"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
