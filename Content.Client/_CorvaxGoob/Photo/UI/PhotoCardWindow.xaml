<photo:PhotoCardWindow xmlns="https://spacestation14.io"
    xmlns:photo="clr-namespace:Content.Client._CorvaxGoob.Photo.UI"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    MouseFilter="Stop" Resizable="False">
    <!-- <Onyx-PhotoCamera-edited> -->
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#FFFFFF"/>
        </PanelContainer.PanelOverride>
        <TextureRect Name="ImageDisplay" VerticalExpand="True" HorizontalExpand="True" SetSize="400 400" Margin="7 27 7 7" Stretch="Scale"/>
        <TextureButton Name="CloseButton" StyleClasses="windowCloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 3 3 0"/>
    </PanelContainer>
    <!-- </Onyx-PhotoCamera-edited> -->
</photo:PhotoCardWindow>
