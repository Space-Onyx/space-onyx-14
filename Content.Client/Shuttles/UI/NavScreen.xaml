<BoxContainer
    Visible="False"
    HorizontalExpand="True"
    xmlns="https://spacestation14.io"
    xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls">
    <ui:ShuttleNavControl
        Name="NavRadar"
        MouseFilter="Stop"
        VerticalAlignment="Stretch"
        VerticalExpand="True"
        HorizontalExpand="True"
        Margin="5 4 10 5"/>
    <!-- Nav controls -->
    <BoxContainer
        Name="RightDisplayNav"
        VerticalAlignment="Top"
        HorizontalAlignment="Right"
        VerticalExpand="True"
        MinWidth="256"
        MaxWidth="256"
        Margin="5 0 5 5"
        Orientation="Vertical">
        <controls:StripeBack MinSize="48 48">
            <Label
                Name="NavDisplayLabel"
                Text="{Loc 'shuttle-console-display-label'}"
                VerticalExpand="True"
                HorizontalAlignment="Center"/>
        </controls:StripeBack>
        <GridContainer
            Columns="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            HorizontalExpand="True"
            Margin="3"
            Name="ReadonlyDisplay">
            <Label Text="{Loc 'shuttle-console-position'}" />
            <Label Name="GridPosition" Text="0.0, 0.0" HorizontalExpand="True" Align="Right" />
            <Label Text="{Loc 'shuttle-console-orientation'}" />
            <Label Name="GridOrientation" Text="0.0" HorizontalExpand="True" Align="Right" />
            <Label Text="{Loc 'shuttle-console-linear-velocity'}" />
            <Label Name="GridLinearVelocity" Text="0.0, 0.0" HorizontalExpand="True" Align="Right" />
            <Label Text="{Loc 'shuttle-console-angular-velocity'}" />
            <Label Name="GridAngularVelocity" Text="0.0" HorizontalExpand="True" Align="Right" />
        </GridContainer>
        <controls:StripeBack MinSize="48 48">
            <Label
                Name="NavSettingsLabel"
                Text="{Loc 'shuttle-console-nav-settings'}"
                VerticalExpand="True"
                HorizontalAlignment="Center"/>
        </controls:StripeBack>
        <Button
            Name="IFFToggle"
            Text="{Loc 'shuttle-console-iff-toggle'}"
            TextAlign="Center"
            ToggleMode="True"/>

        <controls:StripeBack MinSize="48 48">
            <Label Text="{Loc 'shuttle-console-nav-legend'}"
                VerticalExpand="True"
                HorizontalAlignment="Center" />
        </controls:StripeBack>

        <!-- Cargo Dock Toggle -->
        <Button Name="CargoDockToggle"
            HorizontalAlignment="Stretch"
            ToggleMode="True">
            <BoxContainer Orientation="Horizontal" Margin="0 2">
                <TextureRect
                    Stretch="KeepAspectCentered"
                    TexturePath="/Textures/Interface/NavMap/beveled_square.png"
                    Modulate="LightYellow"
                    SetSize="20 20"
                    Margin="10 0 5 0"/>
                <Label
                    Text="{Loc 'shuttle-console-nav-cargo-dock'}"
                    VerticalExpand="True"
                    HorizontalAlignment="Center" />
            </BoxContainer>
        </Button>

        <!-- Arrivals Dock Toggle -->
        <Button Name="ArrivalDockToggle"
            HorizontalAlignment="Stretch"
            ToggleMode="True">
            <BoxContainer Orientation="Horizontal" Margin="0 2">
                <TextureRect
                    Stretch="KeepAspectCentered"
                    TexturePath="/Textures/Interface/NavMap/beveled_square.png"
                    Modulate="Red"
                    SetSize="20 20"
                    Margin="10 0 5 0"/>
                <Label
                    Text="{Loc 'shuttle-console-nav-arrivals-dock'}"
                    VerticalExpand="True"
                    HorizontalAlignment="Center" />
            </BoxContainer>
        </Button>

        <!-- Other Dock Toggle -->
        <Button Name="DockToggle"
            HorizontalAlignment="Stretch"
            ToggleMode="True">
            <BoxContainer Orientation="Horizontal" Margin="0 2">
                <TextureRect
                    Stretch="KeepAspectCentered"
                    TexturePath="/Textures/Interface/NavMap/beveled_square.png"
                    Modulate="Magenta"
                    SetSize="20 20"
                    Margin="10 0 5 0"/>
                <Label VerticalAlignment="Center" Text="{Loc 'shuttle-console-nav-other-dock'}"/>
            </BoxContainer>
        </Button>
        <!-- <Onyx-ShuttleDampening> -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 4 0 0">
            <Button Name="DampenerAnchor" Text="{Loc 'shuttle-console-inertia-dampener-anchor'}" ToggleMode="True" StyleClasses="OpenRight" HorizontalExpand="True" />
            <Button Name="DampenerDampen" Text="{Loc 'shuttle-console-inertia-dampener-dampen'}" ToggleMode="True" StyleClasses="ButtonSquare" HorizontalExpand="True" />
            <Button Name="DampenerCruise" Text="{Loc 'shuttle-console-inertia-dampener-off'}" ToggleMode="True" StyleClasses="OpenLeft" HorizontalExpand="True" />
        </BoxContainer>
        <!-- </Onyx-ShuttleDampening> -->
        <!-- <Onyx-ShuttleSignalPorts> -->
        <controls:StripeBack MinSize="48 48" Margin="0 5 0 0">
            <Label
                Text="{Loc 'shuttle-console-network-ports'}"
                VerticalExpand="True"
                HorizontalAlignment="Center"/>
        </controls:StripeBack>
        <Button Name="DeviceButton1" Text="{Loc 'signal-port-name-shuttle-1'}" TextAlign="Center"/>
        <Button Name="DeviceButton2" Text="{Loc 'signal-port-name-shuttle-2'}" TextAlign="Center"/>
        <Button Name="DeviceButton3" Text="{Loc 'signal-port-name-shuttle-3'}" TextAlign="Center"/>
        <Button Name="DeviceButton4" Text="{Loc 'signal-port-name-shuttle-4'}" TextAlign="Center"/>
        <!-- </Onyx-ShuttleSignalPorts> -->
    </BoxContainer>
</BoxContainer>
