<!-- <Onyx-HealthAnalyzer-Interface-edited> -->
<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client.HealthAnalyzer.UI"
    HeaderClass="BackgroundDark"
    MinSize="790 560"
    SetSize="860 620">
    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="6" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal">
            <Button Name="BodyButton" Text="{Loc health-analyzer-window-body-tab}" MinWidth="120" MinHeight="32" HorizontalExpand="True" ToggleMode="True" Pressed="True" StyleClasses="OpenRight" />
            <Button Name="OrgansButton" Text="{Loc health-analyzer-window-organs-tab}" MinWidth="120" MinHeight="32" HorizontalExpand="True" ToggleMode="True" StyleClasses="OpenBoth" />
            <Button Name="ChemicalsButton" Text="{Loc health-analyzer-window-chemicals-tab}" MinWidth="120" MinHeight="32" HorizontalExpand="True" ToggleMode="True" StyleClasses="OpenLeft" />
        </BoxContainer>
        <ui:HealthAnalyzerControl Name="HealthAnalyzer" HorizontalExpand="True" VerticalExpand="True" />
    </BoxContainer>
</controls:FancyWindow>
<!-- </Onyx-HealthAnalyzer-Interface-edited> -->
