<cartridges:OnyxNanoChatUiFragment
    xmlns="https://spacestation14.io"
    xmlns:cartridges="clr-namespace:Content.Client._Onyx.CartridgeLoader.Cartridges"
    xmlns:dv="clr-namespace:Content.Client._DV.CartridgeLoader.Cartridges"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Orientation="Vertical"
    HorizontalExpand="True"
    VerticalExpand="True"
    Margin="0">

    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True">
        <controls:StripeBack MinSize="48 48"
                             VerticalExpand="False">
            <BoxContainer Orientation="Horizontal"
                          HorizontalExpand="True"
                          Margin="0">
                <TextureRect Name="AppIcon"
                             TexturePath="/Textures/Interface/Nano/ntlogo.svg.png"
                             Stretch="KeepAspectCentered"
                             VerticalAlignment="Center"
                             MinSize="32 32"
                             Margin="4 0 0 0" />
                <Label Text="{Loc nano-chat-title}"
                       StyleClasses="LabelHeading"
                       HorizontalExpand="True"
                       Margin="4 0"
                       VerticalAlignment="Center" />
                <Label Name="OwnNumberLabel"
                       Text="#0000"
                       StyleClasses="LabelSubText"
                       VerticalAlignment="Center"
                       Margin="0 0 2 0" />
                <Button Name="MuteButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 2 0"
                        ToolTip="{Loc nano-chat-toggle-mute}">
                    <Control HorizontalExpand="True" VerticalExpand="True">
                        <TextureRect Name="BellIcon"
                                     StyleClasses="ButtonSquare"
                                     TexturePath="/Textures/_DV/Interface/VerbIcons/bell.svg.png"
                                     Stretch="KeepAspectCentered"
                                     MinSize="18 18" />
                        <TextureRect Name="BellMutedIcon"
                                     StyleClasses="ButtonSquare"
                                     TexturePath="/Textures/_DV/Interface/VerbIcons/bell_muted.png"
                                     Stretch="KeepAspectCentered"
                                     Visible="False"
                                     MinSize="18 18" />
                    </Control>
                </Button>
                <Button Name="NewChatButton"
                        Text="+"
                        MinSize="32 32"
                        MaxSize="32 32"
                        Margin="0 0 2 0"
                        StyleClasses="OpenBoth"
                        ToolTip="{Loc nano-chat-new-chat}" />
                <Button Name="CreateGroupButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 2 0"
                        ToolTip="{Loc nano-chat-create-group-title}">
                    <TextureRect StyleClasses="ButtonSquare"
                                 TexturePath="/Textures/Interface/VerbIcons/group.svg.192dpi.png"
                                 Stretch="KeepAspectCentered"
                                 MinSize="18 18" />
                </Button>
                <Button Name="JoinGroupButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 2 0"
                        ToolTip="{Loc nano-chat-join-group-title}">
                    <TextureRect StyleClasses="ButtonSquare"
                                 TexturePath="/Textures/Interface/VerbIcons/in.svg.192dpi.png"
                                 Stretch="KeepAspectCentered"
                                 MinSize="18 18" />
                </Button>
                <Button Name="LookupButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 2 0"
                        ToolTip="{Loc nano-chat-look-up}">
                    <TextureRect StyleClasses="ButtonSquare"
                                 TexturePath="/Textures/Interface/VerbIcons/examine.svg.192dpi.png"
                                 Stretch="KeepAspectCentered"
                                 MinSize="18 18" />
                </Button>
                <Button Name="ListNumberButton"
                        MaxSize="32 32"
                        StyleClasses="OpenBoth"
                        Margin="0 0 2 0"
                        ToolTip="{Loc nano-chat-list-number}"
                        ToggleMode="True">
                    <TextureRect StyleClasses="ButtonSquare"
                                 TexturePath="/Textures/_DV/Interface/VerbIcons/hamburger_icon.svg.png"
                                 Stretch="KeepAspectCentered"
                                 MinSize="18 18" />
                </Button>
            </BoxContainer>
        </controls:StripeBack>

        <BoxContainer Name="ChatView"
                      Orientation="Horizontal"
                      VerticalExpand="True"
                      HorizontalExpand="True"
                      Margin="0 2 0 0">
            <PanelContainer StyleClasses="AngleRect"
                            VerticalExpand="True"
                            MinSize="190 0"
                            MaxWidth="205">
                <TabContainer Name="ChatTabs"
                              VerticalExpand="True"
                              HorizontalExpand="True"
                              MinWidth="180">
                    <ScrollContainer VerticalExpand="True"
                                     HorizontalExpand="True"
                                     MinWidth="180"
                                     HScrollEnabled="False">
                        <BoxContainer Name="ContactsList"
                                      Orientation="Vertical"
                                      VerticalExpand="True"
                                      HorizontalExpand="True"
                                      MinWidth="172"
                                      Margin="2">
                            <Label Name="NoChatsLabel"
                                   Text="{Loc nano-chat-no-chats}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   StyleClasses="LabelSubText" />
                        </BoxContainer>
                    </ScrollContainer>
                    <ScrollContainer VerticalExpand="True"
                                     HorizontalExpand="True"
                                     MinWidth="180"
                                     HScrollEnabled="False">
                        <BoxContainer Name="GroupsList"
                                      Orientation="Vertical"
                                      VerticalExpand="True"
                                      HorizontalExpand="True"
                                      MinWidth="172"
                                      Margin="2">
                            <Label Name="NoGroupsLabel"
                                   Text="{Loc nano-chat-no-groups}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   StyleClasses="LabelSubText" />
                        </BoxContainer>
                    </ScrollContainer>
                </TabContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="AngleRect"
                            VerticalExpand="True"
                            HorizontalExpand="True"
                            Margin="2 0">
                <BoxContainer Orientation="Vertical"
                              VerticalExpand="True"
                              HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal"
                                  HorizontalExpand="True"
                                  VerticalExpand="False"
                                  Margin="2 1">
                        <Label Name="CurrentChatName"
                               Text="{Loc nano-chat-select-chat}"
                               StyleClasses="LabelHeading"
                               HorizontalExpand="True"
                               VerticalAlignment="Center" />
                        <Label Name="GroupMembersLabel"
                               StyleClasses="LabelSubText"
                               VerticalAlignment="Center"
                               Margin="0 0 6 0"
                               Visible="False" />
                        <Button Name="DeleteChatButton"
                                MaxSize="28 28"
                                Visible="False"
                                StyleClasses="OpenBoth"
                                Margin="0 0 2 0"
                                ToolTip="{Loc nano-chat-delete}">
                            <TextureRect StyleClasses="ButtonSquare"
                                         TexturePath="/Textures/Interface/VerbIcons/delete_transparent.svg.192dpi.png"
                                         Stretch="KeepAspectCentered"
                                         MinSize="16 16" />
                        </Button>
                        <Button Name="LeaveGroupButton"
                                MaxSize="28 28"
                                Visible="False"
                                StyleClasses="OpenBoth"
                                ToolTip="{Loc nano-chat-leave-group}">
                            <TextureRect StyleClasses="ButtonSquare"
                                         TexturePath="/Textures/Interface/VerbIcons/close.svg.192dpi.png"
                                         Stretch="KeepAspectCentered"
                                         MinSize="16 16" />
                        </Button>
                    </BoxContainer>

                    <BoxContainer Name="MessageArea"
                                  Orientation="Vertical"
                                  VerticalExpand="True"
                                  HorizontalExpand="True"
                                  Margin="0">
                        <ScrollContainer Name="MessagesScroll"
                                         VerticalExpand="True"
                                         HorizontalExpand="True"
                                         Visible="False">
                            <BoxContainer Name="MessageList"
                                          Orientation="Vertical"
                                          VerticalExpand="True"
                                          HorizontalExpand="True"
                                          Margin="2" />
                        </ScrollContainer>
                    </BoxContainer>

                    <BoxContainer Name="MessageInputContainer"
                                  Orientation="Horizontal"
                                  HorizontalExpand="True"
                                  Margin="0 2 0 0"
                                  Visible="False">
                        <Label Name="CharacterCount"
                               HorizontalAlignment="Right"
                               StyleClasses="LabelSubText"
                               Margin="0 0 2 0"
                               Visible="False" />
                        <LineEdit Name="MessageInput"
                                  PlaceHolder="{Loc nano-chat-message-placeholder}"
                                  HorizontalExpand="True"
                                  StyleClasses="OpenRight" />
                        <Button Name="SendButton"
                                MinSize="32 32"
                                Disabled="True"
                                StyleClasses="OpenLeft"
                                Margin="2 0 0 0">
                            <TextureRect StyleClasses="ButtonSquare"
                                         TexturePath="/Textures/Interface/Nano/triangle_right.png"
                                         Stretch="KeepAspectCentered" />
                        </Button>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <dv:NanoChatLookupView Name="LookupView"
                               Visible="False" />
    </BoxContainer>
</cartridges:OnyxNanoChatUiFragment>
