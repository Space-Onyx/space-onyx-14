<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               xmlns:telecom="clr-namespace:Content.Client._Onyx.Telecommunications"
               xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
                MinSize="1350 900"
               Title="{Loc 'telecom-traffic-console-title'}">
    <PanelContainer Margin="4">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#07110d" BorderColor="#56c987" BorderThickness="2"/>
        </PanelContainer.PanelOverride>

        <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
            <Label Text="{Loc 'telecom-traffic-console-heading'}"
                   StyleClasses="ConsoleHeading"
                   HorizontalAlignment="Center"/>

            <ui:Separator StyleClasses="LowDivider" Thickness="2" ColorOverride="#56c987" />

            <BoxContainer Orientation="Horizontal"
                          SeparationOverride="8"
                          HorizontalExpand="True"
                          VerticalExpand="True">
                <PanelContainer SetWidth="320"
                                VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BorderColor="#56c987" BorderThickness="1"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="7" SeparationOverride="5">
                        <Label Name="ServerCountLabel"
                               StyleClasses="ConsoleSubHeading"
                               HorizontalAlignment="Center"/>
                        <ui:Separator StyleClasses="LowDivider" Thickness="1" ColorOverride="#56c987" />
                        <ItemList Name="ServerList" VerticalExpand="True"/>
                        <Label Text="{Loc 'telecom-traffic-console-server-hint'}"
                               StyleClasses="ConsoleText"
                               HorizontalAlignment="Center"/>
                    </BoxContainer>
                </PanelContainer>

                <TabContainer Name="RightTabs"
                              MinWidth="480"
                              HorizontalExpand="True"
                              VerticalExpand="True">
                    <BoxContainer Orientation="Horizontal"
                                  HorizontalExpand="True"
                                  VerticalExpand="True"
                                  SeparationOverride="8">
                    <BoxContainer Orientation="Vertical"
                                  MinWidth="380"
                                  VerticalExpand="True"
                                  SeparationOverride="8">
                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderColor="#56c987" BorderThickness="1"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Horizontal" Margin="8" SeparationOverride="8">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                                <Label Name="SelectedServerLabel" StyleClasses="ConsoleSubHeading"/>
                                <Label Name="RoutingStatusLabel" StyleClasses="ConsoleText"/>
                                <Label Name="DiagnosticStatusLabel" StyleClasses="ConsoleText"/>
                            </BoxContainer>
                            <Button Name="RoutingButton" VerticalAlignment="Center" MinWidth="150" StyleClasses="OpenBoth"/>
                        </BoxContainer>
                    </PanelContainer>

                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderColor="#56c987" BorderThickness="1"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="8 8 8 12" SeparationOverride="5">
                            <Label Text="{Loc 'telecom-traffic-console-channels-title'}"
                                   StyleClasses="ConsoleSubHeading"/>
                            <GridContainer Name="ChannelList"
                                                Columns="2"
                                                Margin="0 0 0 2"
                                                HSeparationOverride="4"
                                                VSeparationOverride="2"/>
                        </BoxContainer>
                    </PanelContainer>

                    <Control MinSize="0 8"/>

                    <PanelContainer VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderColor="#56c987" BorderThickness="1"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="5">
                            <BoxContainer Orientation="Vertical" SeparationOverride="4">
                                <Label Text="{Loc 'telecom-traffic-console-graph-title'}"
                                       StyleClasses="ConsoleSubHeading"
                                       HorizontalExpand="True"/>
                                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                    <Label Text="{Loc 'telecom-traffic-console-channel-filter'}"
                                           StyleClasses="ConsoleText"
                                           VerticalAlignment="Center"/>
                                    <OptionButton Name="GraphChannelFilter" MinWidth="130" HorizontalExpand="True"/>
                                    <Button Name="SuccessfulFilter"
                                            Text="{Loc 'telecom-traffic-console-filter-successful'}"
                                            ToggleMode="True"
                                            StyleClasses="OpenBoth"
                                            Pressed="True"/>
                                    <Button Name="FailedFilter"
                                            Text="{Loc 'telecom-traffic-console-filter-failed'}"
                                            ToggleMode="True"
                                            StyleClasses="OpenBoth"
                                            Pressed="True"/>
                                </BoxContainer>
                            </BoxContainer>

                            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                                <Label Text="{Loc 'telecom-traffic-console-legend-received'}"
                                       FontColorOverride="#58c7ff"
                                       StyleClasses="ConsoleText"/>
                                <Label Text="{Loc 'telecom-traffic-console-legend-sent'}"
                                       FontColorOverride="#45e67b"
                                       StyleClasses="ConsoleText"/>
                                <Label Text="{Loc 'telecom-traffic-console-legend-failed'}"
                                       FontColorOverride="#e65454"
                                       StyleClasses="ConsoleText"/>
                                <Label Text="{Loc 'telecom-traffic-console-graph-direction-hint'}"
                                       StyleClasses="ConsoleText"
                                       HorizontalExpand="True"
                                       HorizontalAlignment="Right"/>
                            </BoxContainer>

                            <telecom:TelecomTrafficGraph Name="TrafficGraph" VerticalExpand="True"/>
                            <Label Name="TrafficStatsLabel"
                                   StyleClasses="ConsoleText"
                                   HorizontalAlignment="Center"/>
                        </BoxContainer>
                    </PanelContainer>

                    </BoxContainer>
                        <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BorderColor="#56c987" BorderThickness="1"/>
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="5">
                            <BoxContainer Orientation="Vertical" SeparationOverride="4">
                                <Label Name="LogTitleLabel"
                                       StyleClasses="ConsoleSubHeading"
                                       HorizontalExpand="True"/>
                                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                    <LineEdit Name="LogSearch"
                                              MinWidth="140"
                                              HorizontalExpand="True"
                                              PlaceHolder="{Loc 'telecom-traffic-console-log-search'}"/>
                                    <OptionButton Name="LogStatusFilter" MinWidth="125"/>
                                    <Button Name="LiveLogButton"
                                            Text="{Loc 'telecom-traffic-console-log-live'}"
                                            StyleClasses="OpenBoth"/>
                                </BoxContainer>
                            </BoxContainer>

                            <ui:Separator StyleClasses="LowDivider" Thickness="1" ColorOverride="#56c987" />

                            <ScrollContainer Name="LogScroll"
                                             HorizontalExpand="True"
                                             VerticalExpand="True"
                                             MinSize="0 220"
                                             HScrollEnabled="False"
                                             ReserveScrollbarSpace="True">
                                <BoxContainer Name="LogContainer"
                                              Orientation="Vertical"
                                              HorizontalExpand="True"
                                              SeparationOverride="4"/>
                            </ScrollContainer>
                        </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>

                    <ScrollContainer HScrollEnabled="False"
                                     VerticalExpand="True"
                                     ReserveScrollbarSpace="True">
                        <BoxContainer Name="HardwareList"
                                      Orientation="Vertical"
                                      Margin="8"
                                      SeparationOverride="8"/>
                    </ScrollContainer>
                </TabContainer>
            </BoxContainer>

            <Label Text="{Loc 'telecom-traffic-console-footer'}"
                   StyleClasses="ConsoleText"
                   HorizontalAlignment="Center"/>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
