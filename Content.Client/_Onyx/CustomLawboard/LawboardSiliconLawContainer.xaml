<BoxContainer
    xmlns="https://spacestation14.io"
    HorizontalExpand="True"
    Orientation="Vertical">
    <RichTextLabel StyleClasses="LabelKeyText" Name="LawNumberLabel" />
    <PanelContainer Margin="20 10 10 0" MinHeight="128">
        <TextEdit Name="LawContent" HorizontalExpand="True" Editable="True" MinHeight="80" />
    </PanelContainer>
    <BoxContainer Orientation="Horizontal" Margin="0 5 0 0" MaxHeight="64">
        <Button Name="MoveUp" Text="{Loc custom-lawboard-up-arrow}" StyleClasses="OpenRight" />
        <Button Name="MoveDown" Text="{Loc custom-lawboard-down-arrow}" StyleClasses="OpenLeft" />
        <Control HorizontalExpand="True" />
        <Button Name="Delete" Text="{Loc silicon-law-ui-delete}" ModulateSelfOverride="Firebrick" />
    </BoxContainer>
    <PanelContainer StyleClasses="HighDivider" Margin="0,1,0,2" />
</BoxContainer>
