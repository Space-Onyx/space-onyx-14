<pda:ModernPdaMenu xmlns="https://spacestation14.io"
                   xmlns:pda="clr-namespace:Content.Client._Onyx.PDA"
                   xmlns:vanilla="clr-namespace:Content.Client.PDA"
                   xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                   xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                   MinSize="610 720"
                   SetSize="610 720">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer Margin="1 1 0 1" MinSize="44 0">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B2026" BorderColor="#3B4650" BorderThickness="0 0 1 0" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="2">
                <Label Name="SidebarBrandLabel" Text="NT" StyleClasses="font-small" FontColorOverride="#718291"
                       HorizontalAlignment="Center" VAlign="Center" MinHeight="26" />
                <PanelContainer SetHeight="1" Margin="0 1 0 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#3B4650" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>
                <pda:PdaSidebarButton Name="HomeButton" HorizontalExpand="True" MinHeight="52" IsCurrent="True"
                                         ToolTip="{Loc 'pda-modern-home'}" />
                <pda:PdaSidebarButton Name="ProgramListButton" Access="Public" HorizontalExpand="True" MinHeight="110"
                                        ButtonText="{Loc 'comp-pda-io-program-list-button'}"
                                        ToolTip="{Loc 'comp-pda-io-program-list-button'}" />
                <pda:PdaSidebarButton Name="SettingsButton" HorizontalExpand="True" MinHeight="110"
                                        ButtonText="{Loc 'comp-pda-io-settings-button'}"
                                        ToolTip="{Loc 'comp-pda-io-settings-button'}" />
                <Control VerticalExpand="True" />
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Margin="0 1 3 0" MinHeight="30">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#161C21" BorderColor="#3B4650" BorderThickness="0 0 0 1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" Margin="8 0" SeparationOverride="8">
                    <ContainerButton Name="StatusTimeButton" ToolTip="{Loc 'pda-modern-copy-hint'}">
                        <Label Name="StatusTimeLabel" Text="--:--:--" StyleClasses="font-small"
                               FontColorOverride="#718291" VerticalAlignment="Center" />
                    </ContainerButton>
                    <Control HorizontalExpand="True" />
                    <Label Name="BatteryLowBadge" Text="{Loc 'pda-modern-battery-low'}" StyleClasses="font-small"
                           VerticalAlignment="Center" FontColorOverride="#E48787" Visible="False" />
                    <Label Name="BatteryLabel" Text="--" StyleClasses="font-small"
                           VerticalAlignment="Center" FontColorOverride="#D7E5DF" />
                    <ProgressBar Name="BatteryBar" MinValue="0" MaxValue="1" Value="1"
                                 SetSize="64 10" VerticalAlignment="Center">
                        <ProgressBar.ForegroundStyleBoxOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#6B9A88" />
                        </ProgressBar.ForegroundStyleBoxOverride>
                    </ProgressBar>
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Orientation="Horizontal" Margin="8 4 8 0" SeparationOverride="6">
                <vanilla:PdaNavigationButton Name="ProgramTitle" Access="Public" HorizontalExpand="True"
                                             InactiveBgColor="#1B2026" ActiveBgColor="#20262C"
                                             CurrentTabBorderThickness="0 0 2 0" Visible="False" />
                <vanilla:PdaNavigationButton Name="ProgramCloseButton" Access="Public" SetWidth="40"
                                             InactiveBgColor="#1B2026" ActiveBgColor="#3D2428"
                                             IconScale="0.5 0.5" Visible="False" IsActive="False" />
            </BoxContainer>

            <BoxContainer Name="ViewContainer" Access="Public" Margin="8 6 8 4"
                              HorizontalExpand="True" VerticalExpand="True">
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="10">
                            <PanelContainer Name="UserCard" HorizontalExpand="True">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#1C2328" BorderColor="#405149" BorderThickness="1" />
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="2">
                                    <Label Name="UserHeaderLabel" Text="{Loc 'pda-modern-profile'}" StyleClasses="font-small" />
                                    <ContainerButton Name="PdaOwnerButton" HorizontalExpand="True"
                                                     ToolTip="{Loc 'pda-modern-copy-hint'}">
                                        <RichTextLabel Name="PdaOwnerLabel" Access="Public" Margin="6 2" />
                                    </ContainerButton>
                                    <ContainerButton Name="IdInfoButton" HorizontalExpand="True"
                                                     ToolTip="{Loc 'pda-modern-copy-hint'}">
                                        <RichTextLabel Name="IdInfoLabel" Access="Public" Margin="6 2" />
                                    </ContainerButton>
                                    <RichTextLabel Name="MiningPointsLabel" Access="Public" Visible="False" Margin="6 2" />
                                </BoxContainer>
                            </PanelContainer>

                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                                <PanelContainer Name="StationCard" HorizontalExpand="True">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#1A2026" BorderColor="#384550" BorderThickness="1" />
                                    </PanelContainer.PanelOverride>
                                    <BoxContainer Orientation="Vertical" Margin="4 2" SeparationOverride="0">
                                        <Label Name="StationHeaderLabel" Text="{Loc 'pda-modern-station'}" StyleClasses="font-small"
                                               FontColorOverride="#84918C" Margin="10 8 10 0" />
                                        <ContainerButton Name="StationNameButton" HorizontalExpand="True"
                                                         ToolTip="{Loc 'pda-modern-copy-hint'}">
                                            <RichTextLabel Name="StationNameLabel" Access="Public" Margin="10 8"
                                                           HorizontalExpand="True" />
                                        </ContainerButton>
                                        <controls:Separator StyleClasses="LowDivider" />
                                        <RichTextLabel Name="ShiftDurationLabel" Margin="10 8" HorizontalExpand="True" />
                                        <controls:Separator StyleClasses="LowDivider" />
                                        <ContainerButton Name="StationAlertLevelButton" HorizontalExpand="True"
                                                         ToolTip="{Loc 'pda-modern-copy-hint'}">
                                            <RichTextLabel Name="StationAlertLevelLabel" Access="Public" Margin="10 8"
                                                           HorizontalExpand="True" />
                                        </ContainerButton>
                                        <controls:Separator StyleClasses="LowDivider" />
                                        <ContainerButton Name="StationAlertLevelInstructionsButton" HorizontalExpand="True"
                                                         ToolTip="{Loc 'pda-modern-copy-hint'}">
                                            <RichTextLabel Name="StationAlertLevelInstructions" Access="Public" Margin="10 8"
                                                           HorizontalExpand="True" />
                                        </ContainerButton>
                                    </BoxContainer>
                                </PanelContainer>
                            </BoxContainer>

                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                                <PanelContainer Name="DeviceCard" HorizontalExpand="True">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#1A2026" BorderColor="#384550" BorderThickness="1" />
                                    </PanelContainer.PanelOverride>
                                    <BoxContainer Orientation="Vertical" Margin="4 2" SeparationOverride="0">
                                        <Label Name="DeviceHeaderLabel" Text="{Loc 'pda-modern-device'}" StyleClasses="font-small"
                                               FontColorOverride="#84918C" Margin="10 8 10 0" />
                                        <BoxContainer Orientation="Horizontal" Margin="10 8" SeparationOverride="8">
                                            <Label Text="{Loc 'pda-modern-row-cartridge'}" StyleClasses="font-small"
                                                   FontColorOverride="#718291" MinWidth="110" />
                                            <Label Name="CartridgeStateLabel" Text="--" StyleClasses="font-small"
                                                   FontColorOverride="#84918C" HorizontalExpand="True"
                                                   HorizontalAlignment="Right" />
                                        </BoxContainer>
                                        <controls:Separator StyleClasses="LowDivider" />
                                        <BoxContainer Orientation="Horizontal" Margin="10 8" SeparationOverride="8">
                                            <Label Text="{Loc 'pda-modern-row-pai'}" StyleClasses="font-small"
                                                   FontColorOverride="#718291" MinWidth="110" />
                                            <Label Name="PaiStateLabel" Text="--" StyleClasses="font-small"
                                                   FontColorOverride="#84918C" HorizontalExpand="True"
                                                   HorizontalAlignment="Right" />
                                        </BoxContainer>
                                    </BoxContainer>
                                </PanelContainer>
                            </BoxContainer>
                        </BoxContainer>
                    </ScrollContainer>

                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <BoxContainer Margin="4 2 4 4">
                            <Label Text="{Loc 'comp-pda-io-program-list-button'}" StyleClasses="LabelHeading"
                                   FontColorOverride="#D7E5DF" HorizontalExpand="True" />
                        </BoxContainer>
                        <BoxContainer Orientation="Horizontal" Margin="4 0 4 4" SeparationOverride="8">
                            <Label Text="{Loc 'pda-modern-disk'}" StyleClasses="font-small"
                                   FontColorOverride="#718291" VerticalAlignment="Center" />
                            <ProgressBar Name="DiskBar" MinValue="0" MaxValue="1" Value="0"
                                         HorizontalExpand="True" SetHeight="8" VerticalAlignment="Center">
                                <ProgressBar.ForegroundStyleBoxOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#6B9A88" />
                                </ProgressBar.ForegroundStyleBoxOverride>
                            </ProgressBar>
                            <Label Name="DiskLabel" Text="--" StyleClasses="font-small" MinWidth="44"
                                   HorizontalAlignment="Right"
                                   FontColorOverride="#84918C" VerticalAlignment="Center" />
                        </BoxContainer>
                        <GridContainer Name="ProgramList" Columns="2" HorizontalExpand="True"
                                       HSeparationOverride="6" VSeparationOverride="6" />
                        </BoxContainer>
                    </ScrollContainer>

                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="Settings" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                            <BoxContainer Margin="4 2 4 4">
                                <Label Text="{Loc 'comp-pda-io-settings-button'}" StyleClasses="LabelHeading"
                                       FontColorOverride="#D7E5DF" HorizontalExpand="True" />
                            </BoxContainer>
                            <pda:ModernPdaSettingsButton Name="AccessRingtoneButton" Access="Public"
                                                         Text="{Loc 'comp-pda-ui-ringtone-button'}"
                                                         Description="{Loc 'comp-pda-ui-ringtone-button-description'}" />
                            <pda:ModernPdaSettingsButton Name="ActivateMusicButton" Access="Public" Visible="False"
                                                         Text="{Loc 'pda-bound-user-interface-music-button'}"
                                                         Description="{Loc 'pda-bound-user-interface-music-button-description'}" />
                            <pda:ModernPdaSettingsButton Name="ShowUplinkButton" Access="Public" Visible="False"
                                                         Text="{Loc 'pda-bound-user-interface-show-uplink-title'}"
                                                         Description="{Loc 'pda-bound-user-interface-show-uplink-description'}" />
                            <pda:ModernPdaSettingsButton Name="LockUplinkButton" Access="Public" Visible="False"
                                                         Text="{Loc 'pda-bound-user-interface-lock-uplink-title'}"
                                                         Description="{Loc 'pda-bound-user-interface-lock-uplink-description'}" />
                            <PanelContainer Name="ThemePanel" Margin="0 4 0 0">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="#1A2026" BorderColor="#384550" BorderThickness="1" />
                                </PanelContainer.PanelOverride>
                                <BoxContainer Orientation="Vertical" Margin="10 8" SeparationOverride="6">
                                    <BoxContainer Orientation="Horizontal">
                                        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                            <Label Text="{Loc 'pda-modern-theme-title'}" StyleClasses="LabelKeyText" />
                                            <Label Text="{Loc 'pda-modern-theme-description'}" StyleClasses="font-small"
                                                   FontColorOverride="#84918C" />
                                        </BoxContainer>
                                        <PanelContainer Name="ThemeColorPreview" SetSize="34 34" VerticalAlignment="Center" />
                                    </BoxContainer>
                                    <OptionButton Name="ThemePreset" HorizontalExpand="True" />
                                    <ColorSelectorSliders Name="ThemePicker" IsAlphaVisible="False" HorizontalExpand="True" />
                                    <Button Name="ThemeResetButton" Text="{Loc 'pda-modern-theme-reset'}" HorizontalExpand="True" />
                                </BoxContainer>
                            </PanelContainer>
                        </BoxContainer>
                    </ScrollContainer>

                    <BoxContainer Name="ProgramView" Access="Public" Orientation="Vertical"
                                   HorizontalExpand="True" VerticalExpand="True"
                                   Margin="-8 -6 -8 -4" />
            </BoxContainer>

            <PanelContainer Margin="8 0 8 2" MinHeight="46">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#161C21" BorderColor="#3B4650" BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" Margin="6 3" SeparationOverride="6">
                    <vanilla:PdaNavigationButton Name="FlashLightToggleButton" Access="Public" ToggleMode="True"
                                                 HorizontalExpand="True"
                                                 InactiveBgColor="#161C21" ActiveBgColor="#35463E"
                                                 InactiveFgColor="#84918C" ActiveFgColor="#F2EBAA"
                                                 ToolTip="{Loc 'comp-pda-ui-toggle-flashlight-button'}" />
                    <vanilla:PdaNavigationButton Name="EjectPenButton" Access="Public" HorizontalExpand="True"
                                                 InactiveBgColor="#161C21" ActiveBgColor="#20262C"
                                                 InactiveFgColor="#84918C" ActiveFgColor="#D7E5DF"
                                                 ToolTip="{Loc 'comp-pda-ui-eject-pen-button'}" />
                    <vanilla:PdaNavigationButton Name="EjectIdButton" Access="Public" HorizontalExpand="True"
                                                 InactiveBgColor="#161C21" ActiveBgColor="#20262C"
                                                 InactiveFgColor="#84918C" ActiveFgColor="#D7E5DF"
                                                 ToolTip="{Loc 'comp-pda-ui-eject-id-button'}" />
                    <vanilla:PdaNavigationButton Name="EjectPaiButton" Access="Public" HorizontalExpand="True"
                                                 InactiveBgColor="#161C21" ActiveBgColor="#20262C"
                                                 InactiveFgColor="#84918C" ActiveFgColor="#D7E5DF"
                                                 ToolTip="{Loc 'pda-modern-eject-pai'}" />
                    <vanilla:PdaNavigationButton Name="PowerOffButton" Access="Public" HorizontalExpand="True"
                                                 InactiveBgColor="#161C21" ActiveBgColor="#3D2428"
                                                 ActiveFgColor="#E48787" ToolTip="{Loc 'pda-modern-power-off'}" />
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Name="AddressPanel" HorizontalExpand="True" SetHeight="28" Margin="1 0 2 1">
                <controls:StripeBack HasBottomEdge="False" HasMargins="False" HorizontalExpand="True">
                    <Label Text="{Loc 'comp-pda-ui-menu-title'}" VerticalAlignment="Center" Margin="6 0"
                           StyleClasses="PdaContentFooterText" />
                    <Label Name="AddressLabel" Text="-" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Margin="6 0" StyleClasses="PdaContentFooterText" />
                    <ContainerButton Name="AddressCopyButton" ToolTip="{Loc 'pda-modern-copy-hint'}">
                    </ContainerButton>
                </controls:StripeBack>
            </BoxContainer>

        </BoxContainer>
    </BoxContainer>
</pda:ModernPdaMenu>
