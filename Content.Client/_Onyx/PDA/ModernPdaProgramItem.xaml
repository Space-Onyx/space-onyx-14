<pda:ModernPdaProgramItem xmlns="https://spacestation14.io"
                          xmlns:pda="clr-namespace:Content.Client._Onyx.PDA"
                          HorizontalExpand="True" MinHeight="86">
    <PanelContainer Name="Background" />
    <BoxContainer Margin="10 8" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer Name="IconPanel" MinSize="50 50" MaxSize="50 50" VerticalAlignment="Center">
            <AnimatedTextureRect Name="Icon" Margin="8" />
        </PanelContainer>
        <BoxContainer Orientation="Vertical" Margin="10 0 0 0" HorizontalExpand="True">
            <Label Name="ProgramName" StyleClasses="LabelKeyText" ClipText="True" HorizontalExpand="True" />
            <Label Name="ProgramStatus" StyleClasses="font-small" FontColorOverride="#718079" />
            <Control VerticalExpand="True" />
            <Button Name="InstallButton" Visible="False" MinWidth="104" MinHeight="26"
                     HorizontalAlignment="Right" />
        </BoxContainer>
    </BoxContainer>
</pda:ModernPdaProgramItem>
