<pda:ModernPdaProgramItem xmlns="https://spacestation14.io"
                          xmlns:pda="clr-namespace:Content.Client._Onyx.PDA"
                          HorizontalExpand="True" MinHeight="82">
    <PanelContainer Name="Background" />
    <BoxContainer HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer Name="AccentBar" SetWidth="6" />
        <BoxContainer Margin="9 7" HorizontalExpand="True" VerticalExpand="True">
            <AnimatedTextureRect Name="Icon" MinSize="38 38" MaxSize="38 38" Margin="2 0"
                                 VerticalAlignment="Center" />
            <BoxContainer Orientation="Vertical" Margin="9 0 0 0" HorizontalExpand="True">
                <RichTextLabel Name="ProgramName" HorizontalExpand="True" SetHeight="38" />
                <Label Name="ProgramStatus" StyleClasses="font-small" FontColorOverride="#718079" />
                <Button Name="InstallButton" Visible="False" MinWidth="96" MinHeight="26"
                        HorizontalAlignment="Right" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</pda:ModernPdaProgramItem>
