<Control xmlns="https://spacestation14.io" Margin="0 0 0 10">
    <PanelContainer StyleClasses="BackgroundDark">
        <BoxContainer Orientation="Vertical" Margin="5">
            <RichTextLabel Name="DeviceName" />
            <BoxContainer Orientation="Horizontal" Margin="0 5 0 0">
                <Button Name="MoveButton" Text="{Loc ai-remote-ui-menu-moveto}" />
                <Control Margin="2 0 0 0" />
                <Button Name="TakeControlButton" Text="{Loc ai-remote-control}" />
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</Control>
