<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
                      Title="{Loc 'research-experiment-scanner-window-title'}"
                      SetSize="640 600" MinSize="540 460">
    <ScrollContainer Margin="8" ReturnMeasure="True" VerticalExpand="True" HScrollEnabled="False">
        <BoxContainer Name="RootContainer" Orientation="Vertical" SeparationOverride="8">

            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#20232A" BorderColor="#454B57" BorderThickness="1"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Name="ServerContainer" Orientation="Vertical" Margin="10 8" SeparationOverride="4">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Name="ServerLabel" StyleClasses="LabelHeading" Modulate="#C7D5E0" HorizontalExpand="True" VerticalAlignment="Center"/>
                        <Button Name="ServerButton" Text="{Loc 'research-machine-common-server-list'}" VerticalAlignment="Center"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1B1E24" BorderColor="#3F4651" BorderThickness="1"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Name="ExperimentsContainer" Orientation="Vertical" Margin="10 8" SeparationOverride="4">
                    <Label Text="{Loc 'research-experiment-machine-experiments-title'}" Modulate="#C7D5E0"/>
                    <PanelContainer StyleClasses="LowDivider"/>
                    <BoxContainer Name="Experiments" Orientation="Vertical" SeparationOverride="6"/>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1B1E24" BorderColor="#3F4651" BorderThickness="1"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Name="LogContainer" Orientation="Vertical" Margin="10 8" SeparationOverride="4">
                    <Label Text="{Loc 'research-machine-common-last-operation-title'}" Modulate="#C7D5E0"/>
                    <PanelContainer StyleClasses="LowDivider"/>
                    <RichTextLabel Name="LastResult" Margin="0 2 0 0"/>
                </BoxContainer>
            </PanelContainer>

        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
