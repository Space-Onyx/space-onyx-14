<Control xmlns="https://spacestation14.io"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         Margin="0 1">
    <BoxContainer Orientation="Horizontal">
        <PanelContainer Name="Background" Access="Public" VerticalExpand="True" HorizontalExpand="False" MinWidth="5" MaxWidth="5">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#FFFFFF"/>
            </PanelContainer.PanelOverride>
        </PanelContainer>
        <Button Name="Main" Disabled="True" HorizontalExpand="True" VerticalExpand="False" StyleClasses="ButtonSquare" Margin="0">
            <BoxContainer Orientation="Horizontal" Margin="0">
                <TextureRect Name="Showcase" HorizontalExpand="False" VerticalExpand="False" Margin="1" TextureScale="1 1"/>
                <Control MinWidth="5"/>
                <RichTextLabel Name="NameLabel" StyleClasses="LabelSubText" VerticalAlignment="Center"/>
            </BoxContainer>
        </Button>
    </BoxContainer>
</Control>
