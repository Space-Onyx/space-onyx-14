<controls:SurgeryWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Onyx.Medical.Surgery"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc 'surgery-ui-title'}"
    SetSize="960 570"
    MinSize="820 460">
    <PanelContainer Margin="4">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#111619" BorderColor="#5A8F84" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="10">
            <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                <PanelContainer SetSize="44 44">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#20312F" BorderColor="#70B8A9" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <Label Text="+" StyleClasses="LabelHeading" FontColorOverride="#8FD8C9"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                </PanelContainer>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                    <Label Text="{Loc 'surgery-ui-heading'}" StyleClasses="LabelHeading" FontColorOverride="#D7F2EC" />
                    <Label Name="ContextLabel" Access="Public" Text="{Loc 'surgery-ui-context-none'}"
                           StyleClasses="LabelSubText" FontColorOverride="#8FA9A3" />
                </BoxContainer>
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" SetHeight="1" />

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="10">
                <PanelContainer SetWidth="255" VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#171D20" BorderColor="#303B3E" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
                        <Label Text="{Loc 'surgery-ui-navigation'}" StyleClasses="LabelSubText"
                               FontColorOverride="#718681" Margin="4 0 0 3" />
                        <Button Name="PartsButton" Access="Public" HorizontalExpand="True"
                                StyleClasses="ButtonSquare" MinHeight="48">
                            <BoxContainer Orientation="Vertical" Margin="5 2" VerticalAlignment="Center">
                                <Label Text="{Loc 'surgery-ui-nav-parts'}" FontColorOverride="#D7F2EC" />
                            </BoxContainer>
                        </Button>
                        <Button Name="SurgeriesButton" Access="Public" HorizontalExpand="True"
                                StyleClasses="ButtonSquare" MinHeight="48">
                            <BoxContainer Orientation="Vertical" Margin="5 2" VerticalAlignment="Center">
                                <Label Text="{Loc 'surgery-ui-nav-surgeries'}" FontColorOverride="#D7F2EC" />
                            </BoxContainer>
                        </Button>
                        <Button Name="StepsButton" Access="Public" HorizontalExpand="True"
                                StyleClasses="ButtonSquare" MinHeight="48">
                            <BoxContainer Orientation="Vertical" Margin="5 2" VerticalAlignment="Center">
                                <Label Text="{Loc 'surgery-ui-nav-steps'}" FontColorOverride="#D7F2EC" />
                            </BoxContainer>
                        </Button>
                        <Control VerticalExpand="True" />
                    </BoxContainer>
                </PanelContainer>

                <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B2225" BorderColor="#303B3E" BorderThickness="1" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="8">
                        <Label Name="SectionTitle" Access="Public" Text="{Loc 'surgery-ui-section-parts'}"
                               StyleClasses="LabelHeading" FontColorOverride="#E2ECEA" />
                        <PanelContainer StyleClasses="LowDivider" SetHeight="1" />
                        <ScrollContainer VScrollEnabled="True" HScrollEnabled="False"
                                         ReserveScrollbarSpace="True" HorizontalExpand="True" VerticalExpand="True">
                            <BoxContainer Name="Parts" Access="Public" Orientation="Vertical"
                                          HorizontalExpand="True" SeparationOverride="6" Visible="False" />
                            <BoxContainer Name="Surgeries" Access="Public" Orientation="Vertical"
                                          HorizontalExpand="True" SeparationOverride="6" Visible="False" />
                            <BoxContainer Name="Steps" Access="Public" Orientation="Vertical"
                                          HorizontalExpand="True" SeparationOverride="6" Visible="False" />
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>

    <PanelContainer Name="DisabledPanel" Access="Public" HorizontalExpand="True" VerticalExpand="True" Visible="False">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#080B0DEB" />
        </PanelContainer.PanelOverride>
        <PanelContainer HorizontalAlignment="Center" VerticalAlignment="Center" SetWidth="390">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#24191A" BorderColor="#B85D62" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="18" SeparationOverride="8">
                <Label Text="{Loc 'surgery-ui-unavailable-title'}" StyleClasses="LabelHeading"
                       FontColorOverride="#F0B0B3" HorizontalAlignment="Center" />
                <RichTextLabel Name="DisabledLabel" Access="Public" HorizontalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>
    </PanelContainer>
</controls:SurgeryWindow>
