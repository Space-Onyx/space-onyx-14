<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc language-menu-window-title}"
               SetSize="440 480" MinSize="340 300">
    <BoxContainer Orientation="Vertical" SeparationOverride="6" MinWidth="250">
        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <LineEdit Name="Search" PlaceHolder="{Loc language-menu-search}" HorizontalExpand="True" MinWidth="100" />
            <OptionButton Name="AbilityFilter" ToolTip="{Loc language-menu-filter-tooltip}" />
            <Button Name="ResetFilters" Text="{Loc language-menu-reset}" ToolTip="{Loc language-menu-reset-tooltip}" />
        </BoxContainer>
        <PanelContainer StyleClasses="PdaBorderRect">
            <BoxContainer Orientation="Vertical" Margin="6">
                <Label Text="{Loc language-menu-current-heading}" StyleClasses="LabelSubText" />
                <Label Name="CurrentLanguageLabel" HorizontalExpand="True" StyleClasses="LabelHeading" />
            </BoxContainer>
        </PanelContainer>
        <ui:Separator StyleClasses="LowDivider" />
        <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False" VScrollEnabled="True" MinHeight="50">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Name="NoLanguagesLabel" Text="{Loc language-menu-no-languages}" StyleClasses="LabelSubText"
                       HorizontalAlignment="Center" Margin="8" Visible="False" />
                <BoxContainer Name="OptionsList" HorizontalExpand="True" SeparationOverride="4" Orientation="Vertical" />
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
