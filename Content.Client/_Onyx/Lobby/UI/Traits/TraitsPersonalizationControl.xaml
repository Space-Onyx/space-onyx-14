<BoxContainer xmlns="https://spacestation14.io"
              Orientation="Vertical"
              HorizontalExpand="True"
              VerticalExpand="True">
    <PanelContainer StyleClasses="OnyxTraitsHeader" Margin="0 0 0 8">
        <BoxContainer Orientation="Vertical" Margin="10 8">
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'trait-personalization-title'}" StyleClasses="OnyxTraitTitle" />
                <Control HorizontalExpand="True" />
                <Label Name="SelectionSummary" StyleClasses="OnyxTraitStat" />
            </BoxContainer>
            <Label Text="{Loc 'trait-personalization-description'}"
                   StyleClasses="LabelWeak"
                   Margin="0 3 0 0" />
            <PanelContainer Name="PointsBarBackground"
                            StyleClasses="OnyxTraitsProgressBackground"
                            SetHeight="10"
                            Margin="0 7 0 0">
                <PanelContainer Name="PointsBar"
                                StyleClasses="OnyxTraitsProgressFill"
                                HorizontalAlignment="Left" />
            </PanelContainer>
        </BoxContainer>
    </PanelContainer>

    <PanelContainer StyleClasses="OnyxTraitsSearch" Margin="0 0 0 8">
        <LineEdit Name="SearchBar"
                  PlaceHolder="{Loc 'trait-personalization-search'}"
                  HorizontalExpand="True"
                  Margin="8 6" />
    </PanelContainer>

    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
        <BoxContainer Name="Categories" Orientation="Vertical" HorizontalExpand="True" Margin="0 0 4 0" />
    </ScrollContainer>
</BoxContainer>
