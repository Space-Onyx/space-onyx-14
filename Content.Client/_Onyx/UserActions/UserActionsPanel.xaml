<controls:UserActionsPanel
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Onyx.UserActions"
    xmlns:tabs="clr-namespace:Content.Client._Onyx.UserActions.Tabs">
    <PanelContainer StyleClasses="BackgroundDark" MinWidth="300" MinHeight="216" VerticalExpand="True" HorizontalExpand="True">
        <LayoutContainer>
            <TabContainer Name="TabContainer" Margin="2" HorizontalExpand="True" VerticalExpand="True">
                <tabs:StatusTabControl Name="StatusTabControl" />
                <tabs:EmotesTabControl Name="EmotesTabControl" />
            </TabContainer>
            <BoxContainer Name="PingContainer" Orientation="Horizontal" SeparationOverride="3" MouseFilter="Ignore">
                <Label Name="PingValue" StyleClasses="LabelMonospaceText" MouseFilter="Ignore" />
                <Label Name="AveragePingValue" StyleClasses="LabelWeak LabelMonospaceText" MouseFilter="Ignore" />
            </BoxContainer>
        </LayoutContainer>
    </PanelContainer>
</controls:UserActionsPanel>
