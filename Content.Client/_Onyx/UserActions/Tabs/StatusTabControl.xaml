<controls:StatusTabControl
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Onyx.UserActions.Tabs"
    xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls">
    <PanelContainer StyleClasses="BorderedWindowPanel" RectClipContent="True">
        <ScrollContainer Name="StatusScroll" Margin="0" MinHeight="100" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Horizontal" SeparationOverride="0" HorizontalExpand="True">
                <BoxContainer Name="ContentBox" Orientation="Vertical" SeparationOverride="0" HorizontalExpand="True">
                    <PanelContainer StyleClasses="WindowHeadingBackgroundLight">
                        <ContainerButton Name="RoundToggle" ToggleMode="True" MinHeight="17" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="7 0 0 0" HorizontalExpand="True">
                                <Label Name="RoundChevron" Text="▼" StyleClasses="StatusTabFont" />
                                <Label Text="{Loc 'user-action-control-round'}" StyleClasses="StatusTabFont" HorizontalExpand="True" ClipText="True" />
                            </BoxContainer>
                        </ContainerButton>
                    </PanelContainer>
                    <ui:Separator Name="RoundHeaderDivider" StyleClasses="LowDivider" HorizontalExpand="True" />
                    <CollapsibleBody Name="RoundBody">
                        <BoxContainer Orientation="Vertical" SeparationOverride="0" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="7 1 2 1" HorizontalExpand="True">
                                <BoxContainer Orientation="Vertical" SeparationOverride="-2" HorizontalExpand="True" SizeFlagsStretchRatio="1">
                                    <Label Text="{Loc 'user-action-control-map'}" StyleClasses="LabelWeak StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                    <Label Name="MapName" StyleClasses="LabelKeyText StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                </BoxContainer>
                                <BoxContainer Orientation="Vertical" SeparationOverride="-2" HorizontalExpand="True" SizeFlagsStretchRatio="1">
                                    <Label Text="{Loc 'user-action-control-round-id'}" StyleClasses="LabelWeak StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                    <Label Name="RoundId" StyleClasses="LabelKeyText StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                </BoxContainer>
                                <BoxContainer Orientation="Vertical" SeparationOverride="-2" HorizontalExpand="True" SizeFlagsStretchRatio="1">
                                    <Label Text="{Loc 'user-action-control-game-mode'}" StyleClasses="LabelWeak StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                    <Label Name="GameMode" StyleClasses="LabelKeyText StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                </BoxContainer>
                            </BoxContainer>
                            <ui:Separator StyleClasses="LowDivider" HorizontalExpand="True" />
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="7 1 2 1" HorizontalExpand="True">
                                <BoxContainer Orientation="Vertical" SeparationOverride="-2" HorizontalExpand="True" SizeFlagsStretchRatio="1">
                                    <Label Text="{Loc 'user-action-control-player-count'}" StyleClasses="LabelWeak StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                    <Label Name="PlayerCount" StyleClasses="LabelKeyText StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                </BoxContainer>
                                <Control HorizontalExpand="True" SizeFlagsStretchRatio="1" />
                                <Control HorizontalExpand="True" SizeFlagsStretchRatio="1" />
                            </BoxContainer>
                        </BoxContainer>
                    </CollapsibleBody>
                    <ui:Separator StyleClasses="LowDivider" HorizontalExpand="True" />
                    <PanelContainer StyleClasses="WindowHeadingBackgroundLight">
                        <ContainerButton Name="TimeToggle" ToggleMode="True" MinHeight="17" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="7 0 0 0" HorizontalExpand="True">
                                <Label Name="TimeChevron" Text="▼" StyleClasses="StatusTabFont" />
                                <Label Text="{Loc 'user-action-control-time'}" StyleClasses="StatusTabFont" HorizontalExpand="True" ClipText="True" />
                            </BoxContainer>
                        </ContainerButton>
                    </PanelContainer>
                    <ui:Separator Name="TimeHeaderDivider" StyleClasses="LowDivider" HorizontalExpand="True" />
                    <CollapsibleBody Name="TimeBody">
                        <BoxContainer Orientation="Vertical" SeparationOverride="0" Margin="7 1 2 1" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="4" HorizontalExpand="True">
                                <BoxContainer Orientation="Vertical" SeparationOverride="-2" HorizontalExpand="True" SizeFlagsStretchRatio="1">
                                    <Label Text="{Loc 'user-action-control-round-time'}" StyleClasses="LabelWeak StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                    <Label Name="RoundTime" StyleClasses="LabelKeyText StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                </BoxContainer>
                                <BoxContainer Orientation="Vertical" SeparationOverride="-2" HorizontalExpand="True" SizeFlagsStretchRatio="1">
                                    <Label Text="{Loc 'user-action-control-date'}" StyleClasses="LabelWeak StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                    <Label Name="CurrentDate" StyleClasses="LabelKeyText StatusTabFont" ClipText="True" HorizontalExpand="True" />
                                </BoxContainer>
                                <Control HorizontalExpand="True" SizeFlagsStretchRatio="1" />
                            </BoxContainer>
                        </BoxContainer>
                    </CollapsibleBody>
                </BoxContainer>
                <ui:Separator Name="ScrollDivider" StyleClasses="LowDivider" Orientation="Vertical" VerticalExpand="True" Visible="False" />
            </BoxContainer>
        </ScrollContainer>
    </PanelContainer>
</controls:StatusTabControl>
