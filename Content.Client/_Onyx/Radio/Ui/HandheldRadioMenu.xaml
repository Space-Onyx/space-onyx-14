<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'handheld-radio-menu-title'}"
                      MinSize="360 0">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="8 4 8 4"
                  SeparationOverride="6">
        <PanelContainer StyleClasses="BackgroundPanel">
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          Margin="8 6"
                          SeparationOverride="4"
                          HorizontalAlignment="Center">
                <Label Text="{Loc 'handheld-radio-menu-frequency-label'}"
                       StyleClasses="LabelSubText"
                       HorizontalAlignment="Center"/>
                <BoxContainer Orientation="Horizontal"
                              HorizontalAlignment="Center"
                              SeparationOverride="4">
                    <Button Name="MinusButton" Text="-" MinWidth="32"/>
                    <LineEdit Name="FrequencyEdit" MinWidth="80" PlaceHolder="133.0" Editable="True"/>
                    <Label Text="kHz" VerticalAlignment="Center"/>
                    <Button Name="PlusButton" Text="+" MinWidth="32"/>
                </BoxContainer>
                <Label Name="ChannelLabel" HorizontalAlignment="Center"/>
            </BoxContainer>
        </PanelContainer>
        <controls:Separator StyleClasses="LowDivider"/>
        <Label Text="{Loc 'handheld-radio-menu-audio-label'}" StyleClasses="LabelSubText"/>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="6">
            <Button Name="MicButton"
                    ToggleMode="True"
                    Text="{Loc 'handheld-radio-menu-mic'}"
                    HorizontalExpand="True"/>
            <Button Name="SpeakerButton"
                    ToggleMode="True"
                    Text="{Loc 'handheld-radio-menu-speaker'}"
                    HorizontalExpand="True"/>
        </BoxContainer>
        <controls:Separator StyleClasses="LowDivider"/>
        <BoxContainer Orientation="Horizontal" VerticalAlignment="Bottom">
            <Label Text="{Loc 'handheld-radio-menu-footer-text'}"
                   StyleClasses="WindowFooterText"
                   HorizontalAlignment="Left"
                   HorizontalExpand="True"/>
            <TextureRect StyleClasses="NTLogoDark"
                         Stretch="KeepAspectCentered"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         SetSize="19 19"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
