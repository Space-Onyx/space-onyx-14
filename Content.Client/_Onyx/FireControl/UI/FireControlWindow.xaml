<controls:FancyWindow xmlns="https://spacestation14.io"
        xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
        xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
        xmlns:ui="clr-namespace:Content.Client._Onyx.FireControl.UI"
        Title="{Loc 'gunnery-window-title'}"
        SetSize="1000 800"
        MinSize="800 600">
    <BoxContainer Orientation="Horizontal">
        <BoxContainer Orientation="Vertical" MinWidth="271" MaxWidth="271" Margin="5 0 5 5">
            <controls:StripeBack MinSize="48 48">
                <Label Name="ServerStatus" Text="{Loc 'gunnery-window-disconnected'}"
                       StyleClasses="LabelKeyText" HorizontalAlignment="Center" />
            </controls:StripeBack>
            <Button Name="RefreshButton" Text="{Loc admin-logs-refresh}" StyleClasses="ButtonSquare OpenRight" />
            <controls:StripeBack MinSize="48 48">
                <Label Text="{Loc 'gunnery-guns'}" HorizontalAlignment="Center" />
            </controls:StripeBack>
            <BoxContainer Orientation="Horizontal">
                <Button Name="SelectAllButton" Text="{Loc 'gunnery-select-all'}" StyleClasses="ButtonSquare" HorizontalExpand="True" />
                <Button Name="UnselectAllButton" Text="{Loc 'gunnery-unselect-all'}" StyleClasses="ButtonSquare" HorizontalExpand="True" />
            </BoxContainer>
            <PanelContainer VerticalExpand="True" Margin="0 3">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#111111" />
                </PanelContainer.PanelOverride>
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="ControllablesBox" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>
        <BoxContainer HorizontalExpand="True" Margin="30">
            <ui:FireControlNavControl Name="NavRadar" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
