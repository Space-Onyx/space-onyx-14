cmd-osay-desc = Forces another entity to try to send a message
cmd-osay-help = Usage: { $command } <uid> <type> <message>

osay-command-arg-uid = source uid
osay-command-arg-type = type
osay-command-arg-message = message
# <Onyx-OSayOptions>
osay-command-arg-language = доступный язык речи
osay-command-arg-language-optional = доступный язык речи (необязательно) или сообщение
osay-command-arg-collective-mind = доступный коллективный разум
# </Onyx-OSayOptions>

osay-command-error-args = Недопустимое число аргументов.
osay-command-error-euid = { $arg } не является допустимым entity uid.
# <Onyx-OSayOptions>
osay-command-error-type = { $arg } не является допустимым типом IC-чата.
osay-command-error-collective-mind = У сущности нет доступа к коллективному разуму { $arg }.
# </Onyx-OSayOptions>
