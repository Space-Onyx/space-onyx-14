cmd-osay-desc = Forces another entity to try to send a message
cmd-osay-help = Usage: {$command} <uid> <type> <message>

osay-command-arg-uid = source uid
osay-command-arg-type = type
osay-command-arg-message = message
# <Onyx-OSayOptions>
osay-command-arg-language = spoken language
osay-command-arg-language-optional = spoken language (optional) or message
osay-command-arg-collective-mind = collective mind
# </Onyx-OSayOptions>

osay-command-error-args = Invalid number of arguments
osay-command-error-euid = {$arg} is not a valid entity uid.
# <Onyx-OSayOptions>
osay-command-error-type = { $arg } is not a valid IC chat type.
osay-command-error-collective-mind = The entity does not have access to collective mind { $arg }.
# </Onyx-OSayOptions>
